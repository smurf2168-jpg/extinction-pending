{
  "name": "extinction-pending-overlay",
  "version": "1.0.2",
  "description": "Official Extinction Pending Overlay",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "eu.extinctionpending.overlay",
    "productName": "Extinction Pending Overlay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "icon.ico"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "smurf2168-jpg",
        "repo": "extinction-pending"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
